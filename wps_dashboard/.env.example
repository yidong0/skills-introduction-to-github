# 在 WPS 开放平台 (open.wps.cn) 控制台创建应用后，把凭证填在这里，
# 然后复制这个文件为 .env（.env 已在 .gitignore 中，不会被提交）。

# 应用凭证
WPS_CLIENT_ID=
WPS_CLIENT_SECRET=

# 要采集的在线表格文件标识（file_token）。
# 从表格分享链接中截取，例如：
# https://www.kdocs.cn/l/xxxxxxxx  中的 xxxxxxxx 部分。
WPS_FILE_TOKEN=

# 可选：指定要读取的 sheet 名称；留空则自动使用文件中第一个可见 sheet。
WPS_SHEET_NAME=

# 仪表盘标题
DASHBOARD_TITLE=抖音运营数据仪表盘

# 趋势窗口：仪表盘统计"近 N 天"数据
TREND_WINDOW_DAYS=30
